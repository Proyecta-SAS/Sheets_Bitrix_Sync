{
    "name": "proyecta-sas/sheets-bitrix-sync",
    "description": "Sincronización idempotente de Google Sheets con negociaciones de Bitrix24.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "google/apiclient": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "test": "php tests/run.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "google/apiclient-services": [
            "Sheets"
        ]
    }
}
